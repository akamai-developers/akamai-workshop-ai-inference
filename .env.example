# Akamai Cloud Solutions Architect agent - example config.
# Copy to .env and fill in real values. Never commit .env.

# =============================================================================
# MODEL PROVIDER  (pick one: openai | anthropic | vllm)
# =============================================================================
MODEL_PROVIDER=openai

# OpenAI (default for local testing)
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL_ID=gpt-4.1-2025-04-14

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL_ID=claude-sonnet-4-5-20250929

# vLLM (OpenAI-compatible, self-hosted)
# IMPORTANT: for tool calls to work, launch vLLM with tool-calling enabled, e.g.
# for Qwen2.5:  --enable-auto-tool-choice --tool-call-parser hermes
# Without those flags vLLM returns tool calls as plain text and nothing executes.
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL_ID=meta-llama/Llama-3.1-8B-Instruct
VLLM_API_KEY=placeholder

# =============================================================================
# AKAMAI / LINODE
# =============================================================================
# Scoped, least-privilege Linode personal access token.
LINODE_TOKEN=your_linode_token_here

# Region fallback when the Linode Metadata Service is not reachable
# (for example when running off-cluster). Example: us-ord
AGENT_REGION=

# =============================================================================
# SAFETY / DEMO MODE
# =============================================================================
# When true, destructive ops (delete instance/cluster/bucket) are disabled.
DEMO_MODE=true

# =============================================================================
# DISCORD (optional)
# =============================================================================
DISCORD_TOKEN=

# =============================================================================
# OBSERVABILITY - Langfuse (optional; tracing on only when these are set)
# =============================================================================
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# =============================================================================
# READ TOOLS  via akamai-cloud-mcp (read-only MCP server)
# =============================================================================
# Reads come from the akamai-cloud-mcp server; writes stay local and gated.
MCP_ENABLED=true
# Path to a local checkout until the server is published; run with `uv run`.
# Leave empty to use the published package via `uvx akamai-cloud-mcp`.
AKAMAI_MCP_DIR=
# Scope the tool set so smaller models are not overwhelmed; raise for bigger models.
MCP_DOMAINS=regions,pricing,compute,lke,object_storage,networking,account
MCP_MAX_RESULTS=25

# =============================================================================
# SESSIONS  (conversation memory)
# =============================================================================
# memory = in-process only (the CLI remembers until you exit).
# file   = local/mounted volume (survives restart, single replica).
# s3     = Akamai Object Storage, S3-compatible (survives restart, shared across LKE pods).
SESSION_BACKEND=memory
SESSION_DIR=./.sessions
# For SESSION_BACKEND=s3 (Akamai Object Storage):
SESSION_BUCKET=
SESSION_ENDPOINT_URL=
SESSION_REGION=
# Object Storage access keys are read by boto3 from the environment:
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
