# Agents That Own Their Inference - workshop environment.
# Copy to .env and edit. Never commit .env.
#
# Path A (hosted workshop): you do NOT need this file. The platform already sets
# these in your JupyterLab environment. Run notebooks as-is.
#
# Path B (bring your own): set these to point the notebooks at YOUR vLLM endpoint.
# common/config.py reads exactly the five variables below (see get_settings).

# ---- Connection to your vLLM (the only ones that matter for most labs) -------
# OpenAI-compatible base URL of your vLLM server. In-cluster default is the
# Service name; from a laptop use the IP/host you port-forward or expose.
VLLM_HOST=http://vllm:8000/v1
# The model id your server actually serves (vLLM is single-model per process).
MODEL_NAME=Qwen/Qwen3-4B
# vLLM needs no key by default; the OpenAI client just wants a non-empty string.
VLLM_API_KEY=not-needed

# ---- Kubernetes (only the kubectl labs: 05 optimize, 07 two-models, 09 agent) -
# Your namespace. Leave unset in-cluster and config.py reads it from the
# kubeconfig's current context. Set it explicitly only off-cluster.
# NAMESPACE=
# Path to a kubeconfig scoped to your namespace. Empty = default (~/.kube/config
# or in-cluster). The hosted platform mounts this for you.
# KUBECONFIG=

# ---- Module 01 only: optional hosted-API comparison (skips cleanly if unset) --
# HOSTED_API_KEY=
# HOSTED_BASE_URL=https://api.openai.com/v1
# HOSTED_MODEL=gpt-4o-mini

# ---- Module 07 only: the two co-located models -------------------------------
# FAST_HOST=http://vllm-fast:8000/v1
# SMART_HOST=http://vllm-smart:8000/v1
# FAST_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# SMART_MODEL=Qwen/Qwen2.5-3B-Instruct
